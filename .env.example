# Santillana — variables de entorno. Copiar a .env (fuera de la raíz pública si es posible)
# y NUNCA subirlo al hosting con valores de ejemplo. En Neubox también pueden
# definirse como variables de entorno del panel (tienen prioridad sobre este archivo).

# --- Base de datos ---
SANT_DB_HOST=127.0.0.1
SANT_DB_NAME=santillana
SANT_DB_USER=root
SANT_DB_PASS=

# --- PayPal ---
SANT_PAYPAL_ENV=sandbox
SANT_PAYPAL_CLIENT_ID=
SANT_PAYPAL_SECRET=
SANT_PAYPAL_WEBHOOK_ID=

# --- Admin (correo + hash; generar hash con: php -r "echo password_hash('tu-clave', PASSWORD_DEFAULT);") ---
SANT_ADMIN_EMAIL=admin@santillana-mx.com
SANT_ADMIN_PASS_HASH=

# --- reCAPTCHA v3 (opcional; vacío = desactivado) ---
SANT_RECAPTCHA_SECRET=
SANT_RECAPTCHA_SITEKEY=

# --- SPEI (EDITAR con datos reales) ---
SANT_SPEI_BANCO=Banco Ejemplo
SANT_SPEI_CLABE=000000000000000000
SANT_SPEI_TITULAR=Santillana

# --- Contacto / sitio ---
SANT_CONTACT_EMAIL=ventas@santillana-mx.com
SANT_WHATSAPP=523310642354
SANT_SITE_URL=https://santillana-mx.com/bazar-e.mx
SANT_SHIP_FREE_FROM=99900
SANT_SHIP_COST=14900
